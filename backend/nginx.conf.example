# ==============================================================================
# Nginx Reverse Proxy Configuration for Rohan Deshmukh Website (AWS EC2)
# Replace 'api.rohandeshmukh.in' with your EC2 domain or Elastic IP.
# ==============================================================================

# Upstream Node.js application (Express server on port 3001)
upstream backend_nodes {
    server 127.0.0.1:3001;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name api.rohandeshmukh.in;

    # Redirect all HTTP traffic to HTTPS (enable after Certbot SSL setup)
    # return 301 https://$host$request_uri;

    # Maximum upload size for photos and PDF attachments
    client_max_body_size 50M;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml+rss application/atom+xml image/svg+xml;

    # Static uploads caching (if using local storage on EC2)
    location /uploads/ {
        alias /var/www/rohan-website/backend/uploads/;
        access_log off;
        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Access-Control-Allow-Origin "*";
        try_files $uri =404;
    }

    # API and Express Routes
    location / {
        proxy_pass http://backend_nodes;
        proxy_http_version 1.1;

        # Standard proxy headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        proxy_buffering off;
    }
}
