# ===== backend: Express + Sequelize API (it also serves the built website in production) =====

# --- General ---
NODE_ENV=development
PORT=3001
# The public address of the website (used in links, e-mails, the sitemap and share tags).
# Development: the website runs on port 3000. Production: your domain, e.g. https://rohandeshmukh.in
PUBLIC_URL=http://localhost:3000
# Signs admin sign-in cookies. A long random string — `npm run dev` fills this in for you on first run.
# Production: at least 32 characters (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`).
JWT_SECRET=
# Behind a reverse proxy (nginx, Cloudflare, a hosting panel)? How many proxies sit in front — usually 1.
TRUST_PROXY=

# --- Database ---
# Development: SQLite — one file, nothing to install.
DB_DIALECT=sqlite
SQLITE_PATH=data/rohan.sqlite
# Production: MySQL (or MariaDB). Either the parts…
# DB_DIALECT=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=rohan
# DB_USER=rohan
# DB_PASSWORD=
# DB_SSL=false
# …or a single URL:
# DATABASE_URL=mysql://rohan:password@localhost:3306/rohan

# --- Uploaded photos and documents ---
# local = the backend/uploads folder.  s3 = any S3-compatible bucket (AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO).
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optional: a custom endpoint (R2, Spaces, MinIO), a folder inside the bucket, the public address of the files (CDN) …
# S3_ENDPOINT=
# S3_PREFIX=rohan
# S3_PUBLIC_URL=https://files.rohandeshmukh.in
# S3_FORCE_PATH_STYLE=false

# --- E-mail (form notifications, password reset). Leave SMTP_HOST empty in development: messages are only logged ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Rohan Deshmukh <noreply@rohandeshmukh.in>

# --- Spam protection: Google reCAPTCHA v3 secret key (the site key goes in frontend/.env). Empty = off ---
RECAPTCHA_SECRET_KEY=

# --- The home page's "Stay Connected" section shows the Facebook Page's latest posts. Facebook gives them out only through its API,
# --- so the Page's id and a Page access token are needed (how to get them: README → "Facebook posts on the home page"). Empty = a plain "Visit our Facebook page" button.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
# FACEBOOK_GRAPH_VERSION=v25.0

# --- First admin account, created by `npm run seed` when there are no users yet ---
ADMIN_EMAIL=admin@rohandeshmukh.in
ADMIN_PASSWORD=ChangeMe@123

# --- Nightly backup of the SQLite file (cron syntax; empty = off). Default in production: 02:30 every night ---
# BACKUP_CRON=30 2 * * *
# BACKUP_KEEP=14
