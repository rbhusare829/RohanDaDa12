{
  "name": "rohan-deshmukh-website",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Official website of Rohan Subhash Deshmukh — React + Vite frontend, Express + Sequelize backend (SQLite for development, MySQL for production)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "preview": "node scripts/dev.mjs --prod",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "seed": "npm run seed -w backend",
    "seed:fresh": "npm run seed:fresh -w backend",
    "migrate": "npm run migrate -w backend",
    "import:payload": "npm run import:payload -w backend --",
    "content:hero-covers": "npm run content:hero-covers -w backend",
    "content:intro-education": "npm run content:intro-education -w backend",
    "content:album-update": "npm run content:album-update -w backend",
    "content:home-highlights": "npm run content:home-highlights -w backend",
    "content:initiatives": "npm run content:initiatives -w backend",
    "content:english": "npm run content:english -w backend",
    "content:project-photos": "npm run content:project-photos -w backend",
    "content:home-text": "npm run content:home-text -w backend",
    "content:intro-know-more": "npm run content:intro-know-more -w backend",
    "content:foundation-projects": "npm run content:foundation-projects -w backend",
    "content:political-photos": "npm run content:political-photos -w backend",
    "content:rd-content": "npm run content:rd-content -w backend",
    "content:update": "npm run content:update -w backend",
    "test": "npm run test -w backend",
    "lint": "npm run lint -w backend && npm run lint -w frontend",
    "typecheck": "npm run typecheck -w frontend",
    "e2e": "npm run e2e:site && npm run e2e:admin",
    "e2e:site": "node e2e/site.e2e.mjs",
    "e2e:admin": "node e2e/admin.e2e.mjs",
    "admin": "npm run admin -w backend --",
    "start:prod": "npm run seed -w backend && npm run start -w backend"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "^1.3.4",
    "@img/sharp-linux-x64": "^0.35.5",
    "@rollup/rollup-linux-x64-gnu": "^4.66.0",
    "@rollup/rollup-linux-x64-musl": "^4.66.0",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "@tailwindcss/oxide-linux-x64-musl": "^4.3.3"
  }
}
