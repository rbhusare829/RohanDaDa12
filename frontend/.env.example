# ===== Frontend: Website & Admin Panel (React 19 + Vite for AWS Amplify) =====
# Only variables prefixed with VITE_ are exposed to the browser.

# 1. Backend REST API URL:
# When hosting frontend on AWS Amplify and backend on AWS EC2, set this to your EC2 backend API domain/IP:
# Example: https://api.rohandeshmukh.in or https://ec2-xx-xx-xx-xx.compute-1.amazonaws.com:3001
# In local development: leave empty (Vite automatically proxies /api to http://localhost:3001)
VITE_API_URL=

# 2. Google reCAPTCHA v3 site key for contact form (optional):
VITE_RECAPTCHA_SITE_KEY=

# 3. Google Analytics Measurement ID, e.g. G-XXXXXXXXXX (optional):
VITE_GA_ID=
