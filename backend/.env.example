# ===== Backend: Express + Sequelize API (AWS EC2 / Server Deployment) =====

# --- General Server & Environment ---
NODE_ENV=development
PORT=3001

# The public URL of the frontend website (hosted on AWS Amplify or custom domain):
# In development: http://localhost:3000
# In production on AWS Amplify: e.g. https://main.xxxxxx.amplifyapp.com or https://rohandeshmukh.in
PUBLIC_URL=http://localhost:3000

# CORS Allowed Origins (Comma-separated URLs):
# Crucial when frontend is hosted separately on AWS Amplify!
# Example: https://main.xxxxxx.amplifyapp.com,https://rohandeshmukh.in,https://www.rohandeshmukh.in
CORS_ORIGINS=http://localhost:3000

# Signs admin sign-in cookies and JWT tokens.
# Must be at least 32 random characters in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Set to 1 when behind a reverse proxy on EC2 (Nginx, AWS ALB, CloudFront).
# Ensures client IP, SSL protocol (X-Forwarded-Proto) and rate limits work correctly.
TRUST_PROXY=1

# Cross-domain session cookies (Amplify frontend <-> EC2 backend):
# If frontend is on *.amplifyapp.com and backend is on an EC2 IP/domain, set:
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# --- Database (SQLite or MySQL/PostgreSQL RDS) ---
# Development: SQLite (local file, zero setup)
DB_DIALECT=sqlite
SQLITE_PATH=data/rohan.sqlite

# Production on EC2: MySQL (local on EC2 or AWS RDS MySQL/Aurora)
# DB_DIALECT=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=rohan
# DB_USER=rohan
# DB_PASSWORD=
# DB_SSL=false
# DB_POOL_MAX=15
# Or via single connection string:
# DATABASE_URL=mysql://rohan:password@localhost:3306/rohan

# Automatically run schema migrations on startup (default: true)
AUTO_MIGRATE=true

# --- File Storage (Uploads & Media) ---
# local = saved in backend/uploads directory on EC2.
# s3    = uploaded to AWS S3 bucket.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads

# AWS S3 Settings (Recommended for EC2 production):
# If an IAM Role is attached to your EC2 instance with S3 permissions,
# leave S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY blank! The AWS SDK will use the EC2 role automatically.
# S3_BUCKET=rohan-website-media
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=media
# S3_PUBLIC_URL=https://rohan-website-media.s3.ap-south-1.amazonaws.com

# --- E-mail (Contact form notifications, password resets) ---
# Leave SMTP_HOST empty in development (emails are logged to console).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Rohan Deshmukh <noreply@rohandeshmukh.in>

# --- Google reCAPTCHA v3 (Spam Protection) ---
# Secret key for server verification (Site key goes in frontend/.env)
RECAPTCHA_SECRET_KEY=

# --- Facebook Page Integration ---
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
FACEBOOK_GRAPH_VERSION=v25.0

# --- First Admin Account (Created automatically on initial seed) ---
ADMIN_EMAIL=admin@rohandeshmukh.in
ADMIN_PASSWORD=ChangeMe@123

# --- Automatic Nightly Backups (SQLite only) ---
# Default: 02:30 AM every night
BACKUP_CRON=30 2 * * *
BACKUP_KEEP=14
