# ===== frontend: the website and the admin panel (Vite) =====
# Only variables that start with VITE_ reach the browser.

# Google reCAPTCHA v3 site key for the contact form (the secret key goes in backend/.env). Empty = off.
VITE_RECAPTCHA_SITE_KEY=

# Google Analytics measurement id, e.g. G-XXXXXXXXXX. Empty = no analytics.
VITE_GA_ID=

# Only when the website is hosted separately from the backend (e.g. on a static host): the backend's address.
# Leave empty normally — the website and the API share one address (in development Vite forwards /api to the backend).
VITE_API_URL=
